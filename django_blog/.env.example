# Copy this file to .env and replace the example values. Never commit .env.

# Generate a real key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Avoid keys that start with "$" (django-environ treats that as a variable reference).
SECRET_KEY=example-0f8d2c9a7b6e4f1d3c5a8b9e2d7f6a1c4b3e9d8f7a6c5b4e3d2f1a0b9c8d7e6

# True for local development, False in production
DEBUG=True

# Comma-separated host names (no scheme, no port)
# Production example: ALLOWED_HOSTS=mymentor-oped.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins, with scheme
# Production example: CSRF_TRUSTED_ORIGINS=https://mymentor-oped.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000



# Gmail account used to send password-reset emails.
# EMAIL_HOST_PASSWORD must be a 16-character Gmail App Password
# (Google Account > Security > App passwords), not your normal password.
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=abcdefghijklmnop
